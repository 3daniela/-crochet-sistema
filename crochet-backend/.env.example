# Copiar este archivo como ".env" y llenar con los datos reales de Railway
# (Panel de Railway -> tu servicio MySQL -> pestaña "Variables")

MYSQLHOST=containers-usXX.railway.app
MYSQLPORT=6543
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=tu-password-de-railway

# Clave secreta para firmar los JWT (mínimo 32 caracteres). Generar una propia,
# por ejemplo con: openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-super-secreta-de-al-menos-32-caracteres-1234

# 1 hora en milisegundos
JWT_EXPIRATION_MS=3600000
